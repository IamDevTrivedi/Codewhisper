# Server Port
PORT=5000

# CORS
CORS_ORIGIN=http://localhost:3000

# Database URL
MONGODB_URL=your_mongodb_connection_string

# Node Environment (e.g., development, production)
NODE_ENV=your_environment

# JWT Secret
JWT_SECRET=your_jwt_secret

# Backend URLs
BACKEND_URL=http://localhost:5000
BACKEND_URL_PROD=https://your_backend_prod_url

# Frontend URLs
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_PROD=https://your_frontend_prod_url

# Email Sender ==> the account connected with brevo
SENDER_EMAIL=your_sender_email

# using brevo REST api for sending transactional emails (SMTP less)
BREVO_API_KEY='brevo_api_key'

# Google gemini API key ==> get it from : https://developers.google.com/
GEMINI_API_KEY='gemini_api_key'